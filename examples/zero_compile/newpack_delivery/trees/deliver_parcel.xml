<root BTCPP_format="v4" main_tree_to_execute="deliver_parcel">
  <BehaviorTree ID="deliver_parcel">
    <Sequence name="deliver">
      <Log message="delivering {parcel} to {destination}"/>
      <Compensable id="reserve_courier">
        <Sequence>
          <Log message="courier reserved"/>
          <Wait delay_ms="10"/>
        </Sequence>
        <Log message="courier released (compensation)"/>
      </Compensable>
      <RetryWithDelay attempts="3" delay_ms="10" budget_ms="5000">
        <Fail code="PICKUP_BUSY" message="parcel locker occupied"/>
      </RetryWithDelay>
    </Sequence>
  </BehaviorTree>
</root>
